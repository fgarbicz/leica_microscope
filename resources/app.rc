// version numbers come from project() in CMakeLists.txt (compile definitions)
IDI_ICON1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION DMI_VER_MAJOR,DMI_VER_MINOR,DMI_VER_PATCH,0
PRODUCTVERSION DMI_VER_MAJOR,DMI_VER_MINOR,DMI_VER_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DM Imaging"
      VALUE "FileDescription", "DM Imaging - microscope image acquisition"
      VALUE "FileVersion", DMI_VERSION
      VALUE "ProductName", "DM Imaging"
      VALUE "ProductVersion", DMI_VERSION
      VALUE "OriginalFilename", "DMImaging.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
